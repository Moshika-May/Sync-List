#!/usr/bin/env bash
# syncls: pull folders/repos from your Tailscale machines with arrow-key menus.
# Needs: rsync fzf ssh tailscale. Pulls land in the folder where you started syncls.
set -u -o pipefail
CFG=${XDG_CONFIG_HOME:-$HOME/.config}/syncls
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/syncls
JOBS=$CFG/jobs LOG=$STATE/log
mkdir -p "$CFG" "$STATE"
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
# Dedicated passphrase-less key so the hourly timer works without an ssh-agent.
KEY=$HOME/.ssh/id_ed25519_syncls
SSHB=(ssh -i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5)
# shortcut: key path with spaces breaks the preview commands and rsync, use a $HOME without spaces
export RSYNC_RSH="${SSHB[*]}"

# prints: ok | noauth (cannot log in with the syncls key) | norsync (logged in, rsync missing)
probe() {
  "${SSHB[@]}" "$1" true >/dev/null 2>&1 || { echo noauth; return; }
  "${SSHB[@]}" "$1" 'command -v rsync' >/dev/null 2>&1 && echo ok || echo norsync
}

export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} --bind=right:accept"
KEYS='←back  →/ENTER select  SPACE/TAB mark  ESC quit'
# fzf wrapper: selection goes to $T/sel. Returns 0 ok, 2 left arrow (back), 1 cancelled.
pick() {
  local out rc
  out=$(fzf --expect=left "$@"); rc=$?
  [ "$(head -n1 <<<"$out")" = left ] && return 2
  [ $rc -eq 0 ] || return 1
  tail -n +2 <<<"$out" >"$T/sel"
}

peers() { tailscale status --self=false | awk '($4=="linux"||$4=="macOS") && $5!~/^offline/ {print $2}'; }

# stdin: rsync -i output. $1 = new files out, $2 = differing files out. Path starts at column 13.
classify() {
  : >"$1"; : >"$2"
  awk -v n="$1" -v c="$2" '/^>f\+\+\+\+\+\+\+\+\+ /{print substr($0,13) >n; next} /^>f/{print substr($0,13) >c}'
}

# shortcut: filenames with newlines are unsupported, rename them if it matters
pull_one() { # host remote-rel local-dst mode(auto|ask)
  local host=$1 rel=$2 mode=$4 src dst n c a
  src=$host:$rel/ dst=${3%/}/
  if ! rsync -ai --dry-run --exclude=.git/ --exclude=node_modules/ "$src" "$dst" 2>"$T/err" | classify "$T/new" "$T/con" \
    || [ -s "$T/err" ]; then
    echo "$(date +%FT%T) $host $rel FAILED: $(head -n1 "$T/err")" | tee -a "$LOG"; return 1
  fi
  n=$(wc -l <"$T/new"); c=$(wc -l <"$T/con")
  if [ "$mode" = auto ]; then
    mkdir -p "$dst"
    [ "$n" -gt 0 ] && rsync -a --files-from="$T/new" "$src" "$dst" </dev/null
    echo "$(date +%FT%T) $host $rel new=$n conflicts=$c" >>"$LOG"
    return 0
  fi
  : >"$T/pick"
  if [ "$c" -gt 0 ]; then
    # shortcut: preview breaks on filenames with spaces, picking still works
    fzf -m --bind 'space:toggle+down' --prompt="$rel> " --header="$c differ. TAB = overwrite with remote copy. Unmarked stay as they are. ctrl-a all, ctrl-n none. (- local, + remote)" \
      --bind 'ctrl-a:select-all,ctrl-n:deselect-all' \
      --preview "${SSHB[*]} $host cat -- $rel/{} | diff -u $dst{} - | head -200" <"$T/con" >"$T/pick"
  fi
  cat "$T/new" "$T/pick" >"$T/all"
  [ -s "$T/all" ] || { echo "$rel: up to date"; echo "$(date +%FT%T) $host $rel up to date" >>"$LOG"; return 0; }
  read -rp "$rel: $n new, $(wc -l <"$T/pick") overwrite (backup *.syncls-bak). Go? [Y/n] " a
  case $a in n|N) return 0 ;; esac
  mkdir -p "$dst"
  rsync -a --backup --suffix=.syncls-bak --files-from="$T/all" "$src" "$dst" </dev/null
  echo "$(date +%FT%T) $host $rel new=$n overwritten=$(wc -l <"$T/pick")" >>"$LOG"
}

job_fields() { # one jobs line -> jh jr jd (host, remote path, local folder). Old 2-field lines default to the same path under $HOME.
  IFS=$'\t' read -r jh jr jd <<<"$1"
  [ -n "$jr" ] || read -r jh jr <<<"$jh"
  jd=${jd:-$HOME/$jr}
}

run_jobs() { # file with jobs lines
  local line jh jr jd
  while IFS= read -r line <&3; do job_fields "$line"; pull_one "$jh" "$jr" "$jd" auto; done 3<"$1"
}

# machine -> browse its folders from the home folder -> pull the chosen folder into the current directory.
# In the browser: right/space/tab opens a folder, left goes up, ENTER pulls the highlighted folder.
cmd_pull() {
  local P host cur="" name rel dst a step=1 out k
  P=$(peers); [ -n "$P" ] || { echo "No online Linux/macOS peers in 'tailscale status'."; echo "$(date +%FT%T) - - no online machines" >>"$LOG"; return 1; }
  while :; do
    case $step in
    1) { [ -s "$CFG/last" ] && grep -xF "$(cat "$CFG/last")" <<<"$P"; echo "$P"; } | awk 'NF&&!s[$0]++' >"$T/list"
       pick --prompt='machine> ' --header="$KEYS" <"$T/list" || return 0
       host=$(<"$T/sel"); echo "$host" >"$CFG/last"; cur=""; step=2 ;;
    2) "${SSHB[@]}" "$host" "cd '${cur:-.}' && for d in */; do [ -d \"\$d\" ] || continue; d=\${d%/}; [ -d \"\$d/.git\" ] && m='●' || m=' '; printf '%s\t%s\n' \"\$d\" \"\$m\"; done" 2>/dev/null \
         | while IFS=$'\t' read -r name m; do
             [ -d "$PWD/$name" ] && l='✓ here' || l=''
             printf '%s\t%s %s\n' "$name" "$m" "$l"
           done >"$T/list"
       if [ -z "$cur" ] && [ ! -s "$T/list" ]; then
         echo "No folders in ~ on $host (or cannot log in: run syncls doctor)."; echo "$(date +%FT%T) $host ~ no folders found (or cannot log in)" >>"$LOG"; return 0
       fi
       { [ -n "$cur" ] && printf '.\t⇩ this whole folder\n'; cat "$T/list"; } >"$T/list2"
       out=$(fzf --layout=reverse --expect=left,right,space,tab --delimiter='\t' --prompt="$host:~/$cur> " \
         --header="Pull into: $PWD"$'\n→/SPACE/TAB open   ←up   ENTER pull   ESC quit   ●=git repo  ✓=already here' \
         --preview "${SSHB[*]} $host 'cd ${cur:-.}/'{1}' && du -sh . && git status -sb 2>/dev/null | head -20'" <"$T/list2")
       k=$(head -n1 <<<"$out"); name=$(sed -n 2p <<<"$out" | cut -f1)
       [ -n "$out" ] || return 0   # ESC
       case $k in
         left) if [ -z "$cur" ]; then step=1; elif [[ $cur == */* ]]; then cur=${cur%/*}; else cur=; fi ;;
         right|space|tab) [ -n "$name" ] && [ "$name" != . ] && cur=${cur:+$cur/}$name ;;
         *) [ -n "$name" ] || continue
            if [ "$name" = . ]; then rel=$cur; else rel=${cur:+$cur/}$name; fi
            break ;;
       esac ;;
    esac
  done
  dst=$PWD/${rel##*/}
  pull_one "$host" "$rel" "$dst" ask
  read -rp "Also sync it hourly in the background (new files only)? [y/N] " a
  case $a in y|Y)
    a=$(printf '%s\t%s\t%s' "$host" "$rel" "$dst")
    grep -qxF "$a" "$JOBS" 2>/dev/null || echo "$a" >>"$JOBS" ;;
  esac
}

cmd_auto() {
  [ -s "$JOBS" ] || return 0
  run_jobs "$JOBS"
  if grep -q 'conflicts=[1-9]' "$LOG" && command -v notify-send >/dev/null; then
    notify-send syncls "Some folders have files that differ. Run: syncls pull"
  fi
}

cmd_jobs() { # left arrow: action menu -> job list -> back to main menu
  local sel act rc step=1
  [ -s "$JOBS" ] || { echo "No jobs yet. Add some at the end of: syncls pull"; return 0; }
  while :; do
    if [ $step -eq 1 ]; then
      pick -m --bind 'space:toggle+down' --prompt='jobs> ' --header="$KEYS" <"$JOBS" || return 0
      sel=$(<"$T/sel"); step=2
    else
      printf 'run now\nremove\n' | pick --prompt='action> ' --header="$KEYS"; rc=$?
      case $rc in 2) step=1; continue ;; 0) ;; *) return 0 ;; esac
      act=$(<"$T/sel"); break
    fi
  done
  case $act in
    "run now") printf '%s\n' "$sel" >"$STATE/runjobs.list"
      setsid "$SELF" --run-jobs </dev/null >/dev/null 2>&1 &
      echo "Started in the background. Watch the results in the menu panel (status)." ;;
    remove) grep -vxFf <(echo "$sel") "$JOBS" >"$T/j"; cat "$T/j" >"$JOBS" ;;
  esac
}

cmd_status() {
  [ -s "$LOG" ] || { echo "No runs yet."; return 0; }
  echo "Last run per folder (date host folder result):"
  tac "$LOG" | awk '!s[$2" "$3]++'
}

doctor_run() {
  local c pm h
  command -v pacman >/dev/null && pm="sudo pacman -S" || { command -v apt-get >/dev/null && pm="sudo apt-get install" || pm="sudo dnf install"; }
  for c in rsync fzf ssh tailscale; do
    command -v "$c" >/dev/null && echo "ok      $c" || echo "MISSING $c  ->  $pm $c"
  done
  [ -f "$KEY" ] || echo "NOKEY   $KEY missing  ->  syncls setup"
  for h in $(peers); do
    case $(probe "$h") in
      ok) echo "ok      $h (ssh key + rsync)" ;;
      norsync) echo "FAIL    $h  ->  logged in, but rsync is missing: syncls setup" ;;
      *) echo "FAIL    $h  ->  cannot log in with the syncls key: syncls setup" ;;
    esac
  done
}

cmd_doctor() { doctor_run | tee "$STATE/doctor.txt"; }

# Background doctor: output streams to $PART, lock holds the pid. Menu panel tails it.
LOCK=$STATE/doctor.lock PART=$STATE/doctor.part
doctor_busy() { [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK")" 2>/dev/null; }
bg_doctor() {
  doctor_busy && return
  : >"$PART"
  setsid "$SELF" --run-doctor </dev/null >/dev/null 2>&1 &
  echo $! >"$LOCK"
}
run_doctor() { doctor_run >"$PART" 2>&1; mv "$PART" "$STATE/doctor.txt"; rm -f "$LOCK"; }
cmd_enter() { # what ENTER does on a menu item: quick things run in the background, the rest take the screen
  case $1 in doctor) bg_doctor ;; status) ;; *) "cmd_$1" ;; esac
}

cmd_setup() { # pick machines; for each: ssh username, syncls key, rsync
  local h u cur sel st cfg=$HOME/.ssh/config
  mkdir -p ~/.ssh; touch "$cfg"; chmod 700 ~/.ssh; chmod 600 "$cfg"
  [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -C syncls -f "$KEY"
  peers | pick -m --bind 'space:toggle+down' --prompt='setup> ' --header="$KEYS"$'\nSelect the machines to set up' || return 0
  sel=$(<"$T/sel"); [ -n "$sel" ] || return 0
  for h in $sel; do
    st=$(probe "$h")
    [ "$st" = ok ] && { echo "ok      $h (already set up)"; continue; }
    echo "== $h =="
    if [ "$st" = noauth ]; then
      cur=$(ssh -G "$h" | awk '$1=="user"{print $2}')
      read -rp "Username on $h [$cur] (Enter keeps it): " u
      if [ -n "$u" ] && [ "$u" != "$cur" ]; then
        if grep -E '^\s*Host\s' "$cfg" | grep -qwF -- "$h"; then # change User inside the existing Host block
          awk -v h="$h" -v u="$u" '/^[[:space:]]*Host[[:space:]]/{inb=0; for(i=2;i<=NF;i++) if($i==h) inb=1} inb&&tolower($1)=="user"{$0="    User " u} {print}' "$cfg" >"$cfg.new" && mv "$cfg.new" "$cfg"
        else printf '\nHost %s\n    User %s\n' "$h" "$u" >>"$cfg"; fi
      fi
      echo "Connecting as $(ssh -G "$h" | awk '$1=="user"{print $2}')@$h. Type that account's login password when asked."
      ssh-copy-id -i "$KEY.pub" -o IdentitiesOnly=no "$h" \
        || { echo "skip $h: key copy failed. Wrong username/password? Run syncls setup again. 'Connection reset' = wait a minute, retry."; continue; }
      st=$(probe "$h")
    fi
    if [ "$st" = norsync ]; then
      read -rp "rsync is missing on $h. Install it there with sudo? [y/N] " u
      case $u in y|Y) ssh -i "$KEY" -o IdentitiesOnly=yes -t "$h" 'if command -v pacman >/dev/null; then sudo pacman -S --needed rsync; elif command -v apt-get >/dev/null; then sudo apt-get install -y rsync; else sudo dnf install -y rsync; fi' ;; esac
    elif [ "$st" = noauth ]; then echo "$h: still cannot log in with the syncls key. Check ~/.ssh/authorized_keys permissions on $h."
    fi
  done
  cmd_doctor
}

cmd_selftest() {
  printf '%s\n' '>f+++++++++ a.txt' '>f.st...... dir/b c.txt' 'cd+++++++++ dir/' '.d..t...... ./' | classify "$T/n" "$T/c"
  [ "$(cat "$T/n")" = "a.txt" ] && [ "$(cat "$T/c")" = "dir/b c.txt" ] && echo "selftest ok" || { echo "selftest FAILED"; return 1; }
}

cmd_preview() { # text for the menu's right-hand panel; must be fast (no ssh)
  case $1 in
    pull) echo "Copy folders/repos from another machine to this one."; echo "machine > browse its folders > ENTER pulls into the folder you started syncls in"; echo; cmd_status ;;
    jobs) echo "Folders synced every hour:"; cat "$JOBS" 2>/dev/null || echo "(none yet: answer y to the hourly question after a pull)"; echo; cmd_status ;;
    status) cmd_status ;;
    setup) echo "Pick machines, then set up ssh key + rsync on each."; echo; cat "$STATE/doctor.txt" 2>/dev/null ;;
    doctor) if doctor_busy; then echo "Checking in the background..."; echo; tail -n +1 --pid="$(cat "$LOCK")" -f "$PART"
            else echo "Last doctor result (ENTER runs it again):"; echo; cat "$STATE/doctor.txt" 2>/dev/null || echo "(not run yet)"; fi ;;
  esac
}

# One screen: the list on the left, results on the right. ENTER/right runs the item, the panel then refreshes.
menu() {
  printf 'pull\tcopy folders from another machine\njobs\thourly synced folders\nstatus\tlast result per folder\nsetup\tssh key + rsync on a machine\ndoctor\tcheck everything\n' \
    | fzf --delimiter='\t' --with-nth=1,2 --layout=reverse --prompt='syncls> ' --header='→/ENTER run   ESC quit' \
        --preview "$SELF --preview {1}" --preview-window='right:60%:wrap' \
        --bind "enter:execute($SELF --enter {1})+refresh-preview,right:execute($SELF --enter {1})+refresh-preview" >/dev/null
}

SELF=$(readlink -f "$0")
case ${1:-menu} in
  pull) cmd_pull ;;
  jobs) cmd_jobs ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  setup) cmd_setup ;;
  --auto) cmd_auto ;;
  --preview) cmd_preview "${2:-}" ;;
  --enter) cmd_enter "${2:-}" ;;
  --run-doctor) run_doctor ;;
  --run-jobs) run_jobs "$STATE/runjobs.list" ;;
  --selftest) cmd_selftest ;;
  menu) menu ;;
  *) echo "usage: syncls [pull|jobs|status|setup|doctor|--auto|--selftest]"; exit 2 ;;
esac
