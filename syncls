#!/usr/bin/env bash
# syncls: pull folders/repos from your Tailscale machines with arrow-key menus.
# Needs: rsync fzf ssh tailscale. Same relative path (under $HOME) on both machines.
set -u -o pipefail
CFG=${XDG_CONFIG_HOME:-$HOME/.config}/syncls
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/syncls
JOBS=$CFG/jobs LOG=$STATE/log
mkdir -p "$CFG" "$STATE"
[ -s "$CFG/roots" ] || echo "Workspace/Coding" >"$CFG/roots"
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
export RSYNC_RSH="ssh -o BatchMode=yes -o ConnectTimeout=5"

peers() { tailscale status --self=false | awk '($4=="linux"||$4=="macOS") && $5!~/^offline/ {print $2}'; }

# stdin: rsync -i output. $1 = new files out, $2 = differing files out. Path starts at column 13.
classify() {
  : >"$1"; : >"$2"
  awk -v n="$1" -v c="$2" '/^>f\+\+\+\+\+\+\+\+\+ /{print substr($0,13) >n; next} /^>f/{print substr($0,13) >c}'
}

# shortcut: filenames with newlines are unsupported, rename them if it matters
pull_one() { # host rel/name mode(auto|ask)
  local host=$1 rel=$2 mode=$3 src dst n c a
  src=$host:$rel/ dst=$HOME/$rel/
  if ! rsync -ai --dry-run --exclude=.git/ --exclude=node_modules/ "$src" "$dst" 2>"$T/err" | classify "$T/new" "$T/con" \
    || [ -s "$T/err" ]; then
    echo "$(date +%FT%T) $host $rel FAILED: $(head -n1 "$T/err")" | tee -a "$LOG"; return 1
  fi
  n=$(wc -l <"$T/new"); c=$(wc -l <"$T/con")
  if [ "$mode" = auto ]; then
    mkdir -p "$dst"
    [ "$n" -gt 0 ] && rsync -a --files-from="$T/new" "$src" "$dst" </dev/null
    echo "$(date +%FT%T) $host $rel new=$n conflicts=$c" >>"$LOG"
    return 0
  fi
  : >"$T/pick"
  if [ "$c" -gt 0 ]; then
    # shortcut: preview breaks on filenames with spaces, picking still works
    fzf -m --prompt="$rel> " --header="$c differ. TAB = overwrite with remote copy. Unmarked stay as they are. ctrl-a all, ctrl-n none. (- local, + remote)" \
      --bind 'ctrl-a:select-all,ctrl-n:deselect-all' \
      --preview "ssh -o BatchMode=yes $host cat -- $rel/{} | diff -u $dst{} - | head -200" <"$T/con" >"$T/pick"
  fi
  cat "$T/new" "$T/pick" >"$T/all"
  [ -s "$T/all" ] || { echo "$rel: up to date"; return 0; }
  read -rp "$rel: $n new, $(wc -l <"$T/pick") overwrite (backup *.syncls-bak). Go? [Y/n] " a
  case $a in n|N) return 0 ;; esac
  mkdir -p "$dst"
  rsync -a --backup --suffix=.syncls-bak --files-from="$T/all" "$src" "$dst" </dev/null
  echo "$(date +%FT%T) $host $rel new=$n overwritten=$(wc -l <"$T/pick")" >>"$LOG"
}

cmd_pull() {
  local P host root name a
  P=$(peers); [ -n "$P" ] || { echo "No online Linux/macOS peers in 'tailscale status'."; return 1; }
  host=$({ [ -s "$CFG/last" ] && grep -xF "$(cat "$CFG/last")" <<<"$P"; echo "$P"; } | awk 'NF&&!s[$0]++' \
    | fzf --prompt='machine> ' --header='pull from') || return 0
  echo "$host" >"$CFG/last"
  root=$(fzf --select-1 --prompt='root> ' <"$CFG/roots") || return 0
  sel=$(ssh -o BatchMode=yes "$host" "cd '$root' && for d in */; do d=\${d%/}; [ -d \"\$d/.git\" ] && m='●' || m=' '; printf '%s\t%s\n' \"\$d\" \"\$m\"; done" \
    | while IFS=$'\t' read -r name m; do
        [ -d "$HOME/$root/$name" ] && l='✓ here' || l=''
        printf '%s\t%s %s\n' "$name" "$m" "$l"
      done \
    | fzf -m --delimiter='\t' --prompt='folders> ' --header='TAB select, ENTER pull.  ● git repo   ✓ already on this machine' \
        --preview "ssh -o BatchMode=yes $host 'cd $root/'{1}' && du -sh . && git status -sb 2>&1 | head -20'" \
    | cut -f1) || return 0
  [ -n "$sel" ] || return 0
  while read -r name <&3; do pull_one "$host" "$root/$name" ask; done 3<<<"$sel"
  read -rp "Also sync these hourly in the background (new files only)? [y/N] " a
  case $a in y|Y)
    while read -r name; do grep -qxF "$host $root/$name" "$JOBS" 2>/dev/null || echo "$host $root/$name" >>"$JOBS"; done <<<"$sel" ;;
  esac
}

cmd_auto() {
  local h r
  [ -s "$JOBS" ] || return 0
  while read -r h r <&3; do pull_one "$h" "$r" auto; done 3<"$JOBS"
  if grep -q 'conflicts=[1-9]' "$LOG" && command -v notify-send >/dev/null; then
    notify-send syncls "Some folders have files that differ. Run: syncls pull"
  fi
}

cmd_jobs() {
  local sel act h r
  [ -s "$JOBS" ] || { echo "No jobs yet. Add some at the end of: syncls pull"; return 0; }
  sel=$(fzf -m --prompt='jobs> ' --header='TAB select, ENTER to choose action' <"$JOBS") || return 0
  act=$(printf 'run now\nremove\n' | fzf --prompt='action> ') || return 0
  case $act in
    "run now") while read -r h r <&3; do pull_one "$h" "$r" auto; echo "ran $h $r"; done 3<<<"$sel" ;;
    remove) grep -vxFf <(echo "$sel") "$JOBS" >"$T/j"; cat "$T/j" >"$JOBS" ;;
  esac
}

cmd_status() {
  [ -s "$LOG" ] || { echo "No runs yet."; return 0; }
  echo "Last run per folder (date host folder result):"
  tac "$LOG" | awk '!s[$2" "$3]++'
}

cmd_doctor() {
  local c pm h
  command -v pacman >/dev/null && pm="sudo pacman -S" || { command -v apt-get >/dev/null && pm="sudo apt-get install" || pm="sudo dnf install"; }
  for c in rsync fzf ssh tailscale; do
    command -v "$c" >/dev/null && echo "ok      $c" || echo "MISSING $c  ->  $pm $c"
  done
  for h in $(peers); do
    ssh -o BatchMode=yes -o ConnectTimeout=4 "$h" 'command -v rsync' >/dev/null 2>&1 \
      && echo "ok      $h (ssh key + rsync)" \
      || echo "FAIL    $h  ->  ssh-copy-id $h  and install rsync on it"
  done
}

cmd_selftest() {
  printf '%s\n' '>f+++++++++ a.txt' '>f.st...... dir/b c.txt' 'cd+++++++++ dir/' '.d..t...... ./' | classify "$T/n" "$T/c"
  [ "$(cat "$T/n")" = "a.txt" ] && [ "$(cat "$T/c")" = "dir/b c.txt" ] && echo "selftest ok" || { echo "selftest FAILED"; return 1; }
}

case ${1:-menu} in
  pull) cmd_pull ;;
  jobs) cmd_jobs ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  --auto) cmd_auto ;;
  --selftest) cmd_selftest ;;
  menu) c=$(printf 'pull\njobs\nstatus\ndoctor\n' | fzf --prompt='syncls> ' --header='ENTER to choose') || exit 0; "cmd_$c" ;;
  *) echo "usage: syncls [pull|jobs|status|doctor|--auto|--selftest]"; exit 2 ;;
esac
